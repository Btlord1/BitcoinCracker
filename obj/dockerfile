# ==========================================
# Stage 1: Build & Publish the Application
# ==========================================
FROM ://microsoft.com AS build
WORKDIR /src

# Copy project files and restore dependencies (Optimizes Docker layer caching)
COPY ["BitcoinCracker.csproj", "./"]
RUN dotnet restore "./BitcoinCracker.csproj"

# Copy the rest of the application source code and compile
COPY . .
RUN dotnet publish "BitcoinCracker.csproj" -c Release -o /app/publish /p:UseAppHost=false

# ==========================================
# Stage 2: Final Lightweight Runtime Image
# ==========================================
FROM ://microsoft.com AS final
WORKDIR /app

# Configure default container environment variables
ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

# Expose the internal container port
EXPOSE 8080

# Copy the compiled binaries over from the build stage
COPY --from=build /app/publish .

# Run the app as a secure, built-in non-root user
USER $APP_UID

# Define the container entry point using your app's DLL
ENTRYPOINT ["dotnet", "BitcoinCracker.dll"]
