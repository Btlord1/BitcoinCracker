<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Cracker</RootNamespace>
    <AssemblyName>Cracker</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" Version="1.64.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.11.0" />
    <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageReference Include="NBitcoin" Version="10.0.20" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AboutWindow.xaml.cs" />
    <Compile Remove="App.xaml.cs" />
    <Compile Remove="MainWindow.xaml.cs" />
    <Compile Remove="RowContainer.cs" />
    <Compile Remove="Properties\**\*.cs" />
    <EmbeddedResource Remove="Properties\**\*.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Address.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
